        "    plt.legend(loc='upper right'); plt.grid(True, linestyle='--', alpha=0.7)\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f\"{output_dir}/{safe_name}_{meal_period}_metrics.png\")\n",
        "    plt.close()\n"
